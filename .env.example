# ── Mini Jarvis Configuration ──────────────────────────────────────
# Wake word the voice listener waits for (case-insensitive).
WAKE_WORD=jarvis

# ── Groq AI Agent Configuration ─────────────────────────────────────
# Primary LLM provider: 'groq' (default) or 'ollama' (local)
LLM_PROVIDER=groq

# Your Groq API Key (get a free key at https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Groq Model: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
GROQ_MODEL=llama-3.3-70b-versatile

# ── Local Ollama Fallback (Optional) ───────────────────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
